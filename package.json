{
  "name": "ahoy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bash scripts/fix-xmtp-bindings.sh 2>/dev/null || true",
    "build:client": "esbuild src/client.ts --bundle --outfile=public/app.js --format=esm --target=es2020 --minify",
    "dev": "pnpm run build:client && tsx watch src/index.ts",
    "start": "pnpm run build:client && tsx src/index.ts",
    "release": "tsx scripts/release-numbers.ts",
    "costs": "tsx scripts/costs.ts",
    "call": "tsx scripts/call.ts",
    "sybil": "tsx scripts/sybil-demo.ts",
    "sybil:dry": "tsx scripts/sybil-demo.ts 100 5 --dry-run",
    "dashboard": "tsx scripts/sybil-dashboard.ts",
    "typecheck": "tsc --noEmit",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@hono/node-server": "^1.0.0",
    "@worldcoin/agentkit": "^0.1.0",
    "@worldcoin/minikit-js": "^1.11.0",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/extensions": "^2.8.0",
    "@x402/hono": "^2.0.0",
    "@xmtp/agent-sdk": "^2.3.0",
    "@xmtp/node-bindings": "^1.10.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "hono": "^4.0.0",
    "twilio": "^5.0.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
