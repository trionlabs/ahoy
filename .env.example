# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# x402 Payment
PAY_TO_ADDRESS=
FACILITATOR_URL=https://x402-worldchain.vercel.app/facilitator

# AI Voice (Claude), console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# EAS attestations on World Chain, enables on-chain proof of provisioning
# This is the wallet private key for signing EAS attestations (optional)
DEPLOYER_PRIVATE_KEY=

# World App Mini App, developer.worldcoin.org
WORLD_APP_ID=

# XMTP SMS Bridge (optional, enables SMS <-> XMTP forwarding)
XMTP_ENV=dev
XMTP_WALLET_KEY=              # EOA private key for XMTP agent identity
XMTP_DB_ENCRYPTION_KEY=       # 64 hex chars for local DB encryption

# Server
PORT=4021
BASE_URL= # Could be ngrok
DEV_MODE=false  # true = bypass x402/AgentKit, accept X-Dev-Human-Id header
