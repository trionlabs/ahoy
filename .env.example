# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# x402 Payment
PAY_TO_ADDRESS=
FACILITATOR_URL=https://x402-worldchain.vercel.app/facilitator

# AI Voice — Gemini (primary), aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Voice language & TTS (Twilio)
VOICE_LANGUAGE=tr-TR
VOICE_TTS=Polly.Filiz

# AI Voice — Claude (fallback), console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# EAS attestations on World Chain (optional)
DEPLOYER_PRIVATE_KEY=

# World App Mini App, developer.worldcoclin.org
WORLD_APP_ID=

# XMTP SMS Bridge (optional, enables SMS <-> XMTP forwarding)
XMTP_ENV=production              # dev or production
XMTP_WALLET_KEY=                 # EOA private key for XMTP agent identity
XMTP_DB_ENCRYPTION_KEY=          # 64 hex chars for XMTP local DB encryption
XMTP_DB_DIR=                     # directory for XMTP DB persistence (e.g. /app/data)

# Database
DB_ENCRYPTION_KEY=               # 64 hex chars, AES-256-GCM for phone numbers at rest
DB_PATH=                         # SQLite file path (e.g. /app/data/ahoy.db)

# Server
PORT=4021
BASE_URL=                        # public URL (e.g. https://useahoy.app)
DEV_MODE=false                   # true = bypass x402/AgentKit, accept X-Dev-Human-Id header
